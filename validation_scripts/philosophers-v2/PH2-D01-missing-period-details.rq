PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ont: <http://www.ontologia.fr/OTB/philosopher#>
PREFIX otv: <http://www.ontologia.fr/OTB/otv#>
SELECT DISTINCT ?population ?philosopher ?label ?birthDate ?deathDate ?floruit ?birthPlace ?school
FROM <https://triplestore.talos-ai4ssh.uoc.gr:8890/datasets/Ancient-Greek-Chinese-Philosophers-v2>
WHERE {
  VALUES (?population ?class) { ("Greek" ont:Ancient-Greek-Philosopher) ("Chinese" ont:Ancient-Chinese-Philosopher) }
  ?philosopher otv:instanceOf ?class .
  FILTER NOT EXISTS { ?philosopher ont:livedInPeriod ?period . }
  OPTIONAL { ?philosopher rdfs:label ?label . FILTER(LANG(?label)="en") }
  OPTIONAL { ?philosopher ont:birthDate ?birthDate . }
  OPTIONAL { ?philosopher ont:deathDate ?deathDate . }
  OPTIONAL { ?philosopher ont:floruit ?floruit . }
  OPTIONAL { ?philosopher ont:birthPlace ?birthPlace . }
  OPTIONAL { ?philosopher ont:memberOfSchool ?school . }
}
ORDER BY ?population ?philosopher
